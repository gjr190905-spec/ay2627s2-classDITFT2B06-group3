generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["makan_liao"]
}

enum Role {
  CUSTOMER
  VENDOR
  ADMIN

  @@schema("makan_liao")
}

enum OrderStatus {
  ACCEPTED
  COMPLETED
  COLLECTED

  @@schema("makan_liao")
}

model User {
  id           Int                @id @default(autoincrement())
  displayName  String             @map("display_name")
  email        String             @unique
  passwordHash String             @map("password_hash")
  phone        String?
  role         Role               @default(CUSTOMER)
  isActive     Boolean            @default(true) @map("is_active")
  stallId      Int?               @map("stall_id")
  stall        Stall?             @relation(fields: [stallId], references: [id], onDelete: Restrict)
  createdAt    DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)
  sessions     Session[]
  cart         Cart?
  orders       Order[]
  statusEvents OrderStatusEvent[]
  auditLogs    AdminAuditLog[]

  @@index([stallId])
  @@map("users")
  @@schema("makan_liao")
}

model Session {
  id        Int      @id @default(autoincrement())
  tokenHash String   @unique @map("token_hash")
  userId    Int      @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
  @@schema("makan_liao")
}

model FoodCourt {
  id        Int      @id @default(autoincrement())
  code      String   @unique
  name      String
  location  String?
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  stalls    Stall[]

  @@map("food_courts")
  @@schema("makan_liao")
}

model Stall {
  id             Int        @id @default(autoincrement())
  foodCourtId    Int        @map("food_court_id")
  foodCourt      FoodCourt  @relation(fields: [foodCourtId], references: [id], onDelete: Restrict)
  name           String
  description    String?
  pickupLocation String     @map("pickup_location")
  isOpen         Boolean    @default(false) @map("is_open")
  isActive       Boolean    @default(true) @map("is_active")
  createdAt      DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)
  vendors        User[]
  menuItems      MenuItem[]
  carts          Cart[]
  orders         Order[]

  @@unique([foodCourtId, name])
  @@map("stalls")
  @@schema("makan_liao")
}

model MenuItem {
  id          Int         @id @default(autoincrement())
  stallId     Int         @map("stall_id")
  stall       Stall       @relation(fields: [stallId], references: [id], onDelete: Restrict)
  name        String
  description String?
  category    String?
  priceCents  Int         @map("price_cents")
  isAvailable Boolean     @default(true) @map("is_available")
  isArchived  Boolean     @default(false) @map("is_archived")
  createdAt   DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)
  cartItems   CartItem[]
  orderItems  OrderItem[]

  @@unique([id, stallId])
  @@index([stallId])
  @@map("menu_items")
  @@schema("makan_liao")
}

model Cart {
  id        Int        @id @default(autoincrement())
  userId    Int        @unique @map("user_id")
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  stallId   Int?       @map("stall_id")
  stall     Stall?     @relation(fields: [stallId], references: [id], onDelete: Restrict)
  createdAt DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)
  items     CartItem[]

  @@unique([id, stallId])
  @@index([stallId])
  @@map("carts")
  @@schema("makan_liao")
}

model CartItem {
  id         Int      @id @default(autoincrement())
  cartId     Int      @map("cart_id")
  stallId    Int      @map("stall_id")
  cart       Cart     @relation(fields: [cartId, stallId], references: [id, stallId], onDelete: Cascade, onUpdate: Restrict)
  menuItemId Int      @map("menu_item_id")
  menuItem   MenuItem @relation(fields: [menuItemId, stallId], references: [id, stallId], onDelete: Restrict, onUpdate: Restrict)
  quantity   Int

  @@unique([cartId, menuItemId])
  @@index([menuItemId, stallId])
  @@map("cart_items")
  @@schema("makan_liao")
}

model Order {
  id                Int                @id @default(autoincrement())
  orderNumber       String             @unique @map("order_number")
  customerId        Int                @map("customer_id")
  customer          User               @relation(fields: [customerId], references: [id], onDelete: Restrict)
  stallId           Int                @map("stall_id")
  stall             Stall              @relation(fields: [stallId], references: [id], onDelete: Restrict)
  status            OrderStatus        @default(ACCEPTED)
  checkoutRequestId String             @map("checkout_request_id")
  totalCents        Int                @map("total_cents")
  pickupLocation    String             @map("pickup_location")
  createdAt         DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)
  completedAt       DateTime?          @map("completed_at") @db.Timestamptz(3)
  collectedAt       DateTime?          @map("collected_at") @db.Timestamptz(3)
  items             OrderItem[]
  statusEvents      OrderStatusEvent[]

  @@unique([customerId, checkoutRequestId])
  @@unique([id, stallId])
  @@index([customerId, createdAt])
  @@index([stallId, status, createdAt])
  @@map("orders")
  @@schema("makan_liao")
}

model OrderItem {
  id             Int      @id @default(autoincrement())
  orderId        Int      @map("order_id")
  stallId        Int      @map("stall_id")
  order          Order    @relation(fields: [orderId, stallId], references: [id, stallId], onDelete: Restrict, onUpdate: Restrict)
  menuItemId     Int      @map("menu_item_id")
  menuItem       MenuItem @relation(fields: [menuItemId, stallId], references: [id, stallId], onDelete: Restrict, onUpdate: Restrict)
  itemName       String   @map("item_name")
  unitPriceCents Int      @map("unit_price_cents")
  quantity       Int

  @@index([orderId, stallId])
  @@index([menuItemId, stallId])
  @@map("order_items")
  @@schema("makan_liao")
}

model OrderStatusEvent {
  id             Int          @id @default(autoincrement())
  orderId        Int          @map("order_id")
  order          Order        @relation(fields: [orderId], references: [id], onDelete: Restrict)
  actorId        Int          @map("actor_id")
  actor          User         @relation(fields: [actorId], references: [id], onDelete: Restrict)
  previousStatus OrderStatus? @map("previous_status")
  newStatus      OrderStatus  @map("new_status")
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([orderId, createdAt])
  @@index([actorId])
  @@map("order_status_events")
  @@schema("makan_liao")
}

model AdminAuditLog {
  id         Int      @id @default(autoincrement())
  adminId    Int      @map("admin_id")
  admin      User     @relation(fields: [adminId], references: [id], onDelete: Restrict)
  action     String
  entityType String   @map("entity_type")
  entityId   Int?     @map("entity_id")
  changes    Json?
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([adminId, createdAt])
  @@index([entityType, entityId])
  @@map("admin_audit_logs")
  @@schema("makan_liao")
}

model Person {
  id     Int     @id @default(autoincrement())
  email  String  @unique
  name   String
  avatar String?

  @@schema("makan_liao")
}

model Something {
  id   Int    @id @default(autoincrement())
  name String

  @@schema("makan_liao")
}
